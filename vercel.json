{
  "cleanUrls": true,
  "outputDirectory": "dashboard/static",
  "rewrites": [
    {
      "source": "/static/:match*",
      "destination": "/:match*"
    },
    {
      "source": "/api/logs",
      "destination": "https://bot-trader-dear.onrender.com/api/logs"
    },
    {
      "source": "/api/market/:path*",
      "destination": "https://bot-trader-dear.onrender.com/api/market/:path*"
    },
    {
      "source": "/api/notifications",
      "destination": "https://bot-trader-dear.onrender.com/api/notifications"
    },
    {
      "source": "/api/scheduler/:path*",
      "destination": "https://bot-trader-dear.onrender.com/api/scheduler/:path*"
    },
    {
      "source": "/api/equity/:path*",
      "destination": "https://bot-trader-dear.onrender.com/api/equity/:path*"
    },
    {
      "source": "/api/metrics",
      "destination": "https://bot-trader-dear.onrender.com/api/metrics"
    },
    {
      "source": "/health",
      "destination": "https://bot-trader-dear.onrender.com/health"
    }
  ]
}
